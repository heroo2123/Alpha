                os._exit(0)
        os.close(write_fd)
        child_reaped = False
        try:
            parts = []
            total = 0
            while True:
                part = os.read(read_fd, 65536)
                if not part:
                    break
                total += len(part)
                _require(total <= 1024 * 1024, "RESULT_TOO_LARGE")
                parts.append(part)
