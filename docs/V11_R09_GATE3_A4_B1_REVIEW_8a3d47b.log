   500	            if info["role"] in ("bootstrap", "runtime") and art_id not in reachable:
   501	                unreachable.append(art_id)
   502	        for art_id in sorted(unreachable):
   503	            errors.append(f"UNREACHABLE_DECLARED_ARTIFACT:{art_id}")
