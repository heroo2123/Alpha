    result = evaluate_proposal_bytes(raw)
    assert result["accepted"] is False
    _fixed_fields_present(result)


def test_oversized_raw_bytes_rejected():
    raw = b'{"pad": "' + b'x' * MAX_RAW_BYTES + b'"}'
